def _raise_ai_error(error):
    print(
        f"[MENTOR AI ERROR] "
        f"{type(error).__name__}: {error}",
        flush=True,
    )

    if isinstance(
        error,
        MentorAIUnavailable,
    ):
        raise HTTPException(
            status_code=503,
            detail=str(error),
        ) from error

    raise HTTPException(
        status_code=502,
        detail="Não foi possível obter resposta do serviço de IA.",
    ) from error

