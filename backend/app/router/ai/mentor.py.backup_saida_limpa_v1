@router.get(
    "/teacher/classrooms/{classroom_id}/alerts"
)
def classroom_alerts(
    classroom_id: int,
    current_user: User = Depends(
        require_teacher
    ),
    db: Session = Depends(get_db),
):
    teacher = (
        db.query(Teacher)
        .filter(
            Teacher.user_id == current_user.id
        )
        .first()
    )

    if not teacher:
        raise HTTPException(
            status_code=404,
            detail="Perfil de professor não encontrado.",
        )

    classroom = (
        db.query(Classroom)
        .filter(
            Classroom.id == classroom_id
        )
        .first()
    )

    if not classroom:
        raise HTTPException(
            status_code=404,
            detail="Turma não encontrada.",
        )

    teaches_class = (
        db.query(Subject)
        .filter(
            Subject.teacher_id == teacher.id,
            Subject.classroom_id == classroom_id,
            Subject.ativa == True,
        )
        .first()
    )

    is_dt = (
        classroom.teacher_id == teacher.id
    )

    if not teaches_class and not is_dt:
        raise HTTPException(
            status_code=403,
            detail="Você não possui vínculo com esta turma.",
        )

    enrollments = (
        db.query(Enrollment)
        .filter(
            Enrollment.classroom_id == classroom_id,
            Enrollment.ativo == True,
        )
        .all()
    )

    alerts = []

    for enrollment in enrollments:
        student = enrollment.user
        if not student:
            continue

        metrics = build_student_metrics(
            db,
            student,
        )

        grade = metrics.get(
            "media_geral_percentual"
        )

        attendance = (
            metrics.get("frequencia", {})
            .get("taxa_presenca")
        )

        level = None
        signal = None

        if (
            grade is not None
            and attendance is not None
            and grade < 50
            and attendance < 75
        ):
            level = "critico"
            signal = (
                "Baixo desempenho associado "
                "a frequência reduzida."
            )

        elif (
            (grade is not None and grade < 60)
            or (
                attendance is not None
                and attendance < 80
            )
        ):
            level = "atencao"
            signal = (
                "Há indicadores que merecem "
                "acompanhamento pedagógico."
            )

        elif (
            grade is not None
            and attendance is not None
            and grade >= 85
            and attendance >= 90
        ):
            level = "positivo"
            signal = (
                "Desempenho e frequência "
                "consistentemente positivos."
            )

        if level:
            alerts.append({
                "student_id": student.id,
                "nome": student.nome,
                "nivel": level,
                "sinal": signal,
                "media_percentual": grade,
                "taxa_presenca": attendance,
            })

    aggregate = {
        "turma": classroom.nome,
        "alunos_ativos": len(enrollments),
        "alertas_criticos": sum(
            1
            for item in alerts
            if item["nivel"] == "critico"
        ),
        "alertas_atencao": sum(
            1
            for item in alerts
            if item["nivel"] == "atencao"
        ),
        "sinais_positivos": sum(
            1
            for item in alerts
            if item["nivel"] == "positivo"
        ),
    }

    try:
        result = ask_text(
            instructions=(
                "Você é o analista de turma do Mentor.Edu. "
                "Receberá somente dados agregados. "
                "Faça uma síntese curta de prioridades e "
                "pontos positivos. Não invente fatos."
            ),
            user_input=json.dumps(
                aggregate,
                ensure_ascii=False,
            ),
            smart=False,
        )

        summary = result["text"]
        model = result["model"]
        response_id = result["response_id"]

    except Exception:
        summary = (
            "Resumo de IA indisponível; "
            "os alertas por regras continuam válidos."
        )
        model = None
        response_id = None

    return {
        "resumo": summary,
        "indicadores": aggregate,
        "alertas": alerts,
        "model": model,
        "response_id": response_id,
    }


